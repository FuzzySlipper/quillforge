<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- Version sourced from Desktop's package.json (single source of truth) -->
    <DesktopPackageJsonPath>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), '../QuillForge.Desktop/package.json'))</DesktopPackageJsonPath>
    <Version>0.0.0</Version>
    <!-- Append git short hash to informational version -->
    <SourceRevisionId>unknown</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuillForge.Architecture.Tests" />
  </ItemGroup>

  <!-- Read version from Desktop's package.json (single source of truth).
       Must normalize path separators to forward slashes so Node's require()
       doesn't interpret backslashes as JS escape sequences on Windows. -->
  <Target Name="ReadDesktopVersion" BeforeTargets="GetAssemblyVersion"
          Condition="Exists('$(DesktopPackageJsonPath)')">
    <PropertyGroup>
      <_DesktopPkgJsonNormalized>$(DesktopPackageJsonPath.Replace('\','/'))</_DesktopPkgJsonNormalized>
    </PropertyGroup>
    <Exec Command="node -e &quot;process.stdout.write(require('$(_DesktopPkgJsonNormalized)').version)&quot;"
          ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ReadDesktopVersionValue" />
    </Exec>
    <PropertyGroup>
      <Version Condition="'$(ReadDesktopVersionValue)' != ''">$(ReadDesktopVersionValue)</Version>
    </PropertyGroup>
  </Target>

  <!-- Grab git hash at build time if available -->
  <Target Name="SetGitHash" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == 'unknown'">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <!-- Restore npm deps on fresh clones or after package-lock.json changes.
       npm writes node_modules/.package-lock.json as an install marker, so we
       use it as the output to compare against the real lockfile. -->
  <Target Name="NpmInstall" BeforeTargets="BuildClient"
          Inputs="Client/package-lock.json"
          Outputs="Client/node_modules/.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="Client" />
  </Target>

  <!-- Rebuild React frontend before the SDK snapshots static web assets.
       During publish, the Static Web Assets pipeline resolves and compresses
       wwwroot files before the normal Build target finishes. Running Vite at
       BeforeTargets="Build" can therefore make the SDK manifest point at stale
       hashed asset filenames that Vite deletes moments later. -->
  <Target Name="BuildClient" BeforeTargets="ResolveStaticWebAssetsInputs"
          Inputs="Client/src/**;Client/public/**;Client/index.html;Client/package.json;Client/package-lock.json;Client/tsconfig.json;Client/vite.config.ts"
          Outputs="wwwroot/assets/.build-marker">
    <Exec Command="npm run build" WorkingDirectory="Client" />
    <Touch Files="wwwroot/assets/.build-marker" AlwaysCreate="true" />
  </Target>

  <!-- Include app-docs in publish output so docs endpoints and query_docs work in release builds -->
  <ItemGroup>
    <Content Include="..\..\dev\app-docs\**\*.md" Link="app-docs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Den.Persistence\Den.Persistence.csproj" />
    <ProjectReference Include="..\Den.RulesEngine\Den.RulesEngine.csproj" />
    <ProjectReference Include="..\Den.RulesEngine.Werewolf\Den.RulesEngine.Werewolf.csproj" />
    <ProjectReference Include="..\QuillForge.Core\QuillForge.Core.csproj" />
    <ProjectReference Include="..\QuillForge.Providers\QuillForge.Providers.csproj" />
    <ProjectReference Include="..\QuillForge.Storage\QuillForge.Storage.csproj" />
    <ProjectReference Include="..\..\lib\den-bridge\src\Den.Bridge\Den.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
